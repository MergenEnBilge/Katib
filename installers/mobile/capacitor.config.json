{
  "appId": "io.github.mergenenbilge.katib",
  "appName": "Katib",
  "webDir": "www",
  "server": {
    "androidScheme": "http",
    "iosScheme": "http",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "backgroundColor": "#0b0e0c",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0b0e0c"
  },
  "ios": {
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0b0e0c"
  }
}
