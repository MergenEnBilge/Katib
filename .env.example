# Copy this file to .env and fill it in.

# Password for the Postgres database. Pick anything long.
KATIB_DB_PASSWORD=

# The name people use to reach Katib, such as katib.example.com or 192.168.1.20.
KATIB_HOST=localhost

# "internal" for a private network. For a public domain, use your email address
# and Caddy gets a real certificate.
KATIB_TLS=internal

# The folder on this machine with the photos to label. Katib only reads it.
KATIB_PHOTOS=./photos
